extends layouts/app.pug

block seo
  title Gallery | Gourmet Haven
  meta(name="description" content="Explore the visual artistry of Gourmet Haven. Glimpse into our dining room atmosphere, custom plating techniques, and historic wine vaults.")

block content
  .breadcrumbs
    .container
      a(href="/") Home
      span Gallery

  .page-hero
    .container
      h1 Gallery
      p Visual indulgence and atmosphere at Gourmet Haven

  .container
    .gallery-grid
      .gallery-item
        img(src="/img/dining_room_sanctuary.png" alt="Dining Room Sanctuary")
        .gallery-overlay
          span.category-tag Dining Room
          h3 The Sanctuary
          p An atmosphere of sheer luxury with dark slate, gold accents, and warm ambient light.
          
      .gallery-item
        img(src="/img/cocktail_bar.png" alt="Mixology Lounge")
        .gallery-overlay
          span.category-tag Lounge & Bar
          h3 The Mixology Lounge
          p Artisanal gold-infused cocktails curated by our expert molecular mixologists.
          
      .gallery-item
        img(src="/img/historic_wine_vault.png" alt="Subterranean Wine Vault")
        .gallery-overlay
          span.category-tag Private Vaults
          h3 The Historic Wine Vault
          p Secluded dining inside our brick cellar, surrounded by thousands of vintage bottles.
          
      .gallery-item
        img(src="/img/sommelier_cellar.png" alt="Sommelier Curation")
        .gallery-overlay
          span.category-tag Cellar Curation
          h3 Sommelier's Selection
          p Personal cellar curation and historic vintage pairings guided by our Head Sommelier.
          
      .gallery-item
        img(src="/img/chef_plating_kitchen.png" alt="The Culinary Theatre")
        .gallery-overlay
          span.category-tag Culinary Theatre
          h3 The Culinary Theatre
          p Direct tableside view of Chef Lucien Hale's high-precision finishing techniques.
          
      .gallery-item
        img(src="/img/botanical_terrace_garden.png" alt="Botanical Terrace Garden")
        .gallery-overlay
          span.category-tag Terrace Garden
          h3 The Botanical Terrace
          p Al fresco glass-encased courtyard dining amidst hanging jasmine and linear fire pits.
          
      .gallery-item
        img(src="/img/tableside_service.png" alt="Tableside Narrative")
        .gallery-overlay
          span.category-tag Luxury Service
          h3 Tableside Narrative
          p Immersive tableside plating and sauce pouring, elevating meals into visual stories.
          
      .gallery-item
        img(src="/img/chef_garden.png" alt="Greenhouse Selection")
        .gallery-overlay
          span.category-tag Botanical Curation
          h3 The Glasshouse Curation
          p Harvesting fresh jasmine flowers and micro-greens inside our custom botanical glasshouse.
