.chat-widget#chatWidget
  .chat-header
    span Customer Service
    button.close-chat &times;
  .chat-body
    .message.system
      p Hello! How can we help you today?
  .chat-footer
    input(type="text" placeholder="Type a message...")
    button.send-btn: i.fas.fa-paper-plane
.chat-toggle#chatToggle
  i.fas.fa-comments
